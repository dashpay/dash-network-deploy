#!/usr/bin/env bash

set -ea

. ./lib/cli/utils.sh

ansible_playbook="deploy.yml"
ANSIBLE_TAGS="full_deploy"  # Default tag

CMD_USAGE="Deploy Dash Network

Usage: deploy [options] <network_name>

Options:
  -i        --only-infrastructure         - Only build infrastructure using Terraform
  -p        --only-provisioning           - Only provisioning using Ansible
  -f        --force-deployment            - Force deployment of a devnet branch on a different devnet
  -s        --stage                       - Stage of deployment, defaults to first stage (1)
  -a=<args> --ansible-args=<args>         - Pass extra arguments to ansible-playbook command
  --tags=<tags>                           - Specify tags for deployment (comma-separated). Default: full_deploy
            --ansible-playbook=<playbook> - Specify custom playbook. Default: deploy
            --fast                              - Fast deployment mode (skip non-critical operations)
            --skip-image-update                 - Skip Docker image updates
            --core-restart                      - Include core services in restart (default: platform only)
  -h        --help                        - Show help"

STAGE=1 # Default 

# The network name is now assigned from the first unflagged argument, not from the last argument
NETWORK_NAME=""

# Initialize extra ansible vars
EXTRA_VARS=""

for i in "$@"
do
case ${i} in
    -i|--only-infrastructure)
    ONLY_INFRASTRUCTURE=1
    ;;
    -p|--only-provisioning)
    ONLY_PROVISIONING=1
    ;;
    -f|--force-deployment)
    FORCED_DEPLOYMENT=1
    ;;
    -a=*|--ansible-args=*)
    ANSIBLE_ARGS="${i#*=}"
    ;;
    --tags=*)
    ANSIBLE_TAGS="${i#*=}"
    ;;
    --ansible-playbook=*)
    ansible_playbook="${i#*=}.yml"
    ;;
    --fast)
    EXTRA_VARS="$EXTRA_VARS -e skip_dashmate_image_update=true -e force_logs_config=false"
    echo "Fast mode enabled - skipping Docker image updates and non-critical operations"
    ;;
    --skip-image-update)
    EXTRA_VARS="$EXTRA_VARS -e skip_dashmate_image_update=true"
    ;;
    --core-restart)
    EXTRA_VARS="$EXTRA_VARS -e include_core_restart=true"
    echo "Core restart enabled - will restart both core and platform services"
    ;;
    -s=*|--stage=*)
    STAGE="${i#*=}"
    ;;
    -h|--help)
        echo "$CMD_USAGE"
        exit 0
    ;;
    *)
    if [[ -z "$NETWORK_NAME" ]]; then
        NETWORK_NAME="$i"
    else
        echo "Error: Invalid argument '$i'. Only one network name is allowed."
        echo "$CMD_USAGE"
        exit 1
    fi
    ;;
esac
done

. ./lib/cli/init.sh
. ./lib/cli/terraform.sh
. ./lib/cli/ansible.sh

# Determine the Dash network type from the network name
if [[ "$NETWORK_NAME" == "testnet" ]]; then
    DASH_NETWORK_TYPE="testnet"
elif [[ "$NETWORK_NAME" == "mainnet"* ]]; then
    DASH_NETWORK_TYPE="mainnet"
elif [[ "$NETWORK_NAME" == "devnet"* ]]; then
    DASH_NETWORK_TYPE="devnet"
else
    echo "Error: Unable to determine network type from network name: $NETWORK_NAME"
    exit 1
fi

# Ensure the network name is passed correctly to firstRun.js
node ./bin/firstRun.js ${DASH_NETWORK_TYPE} ${NETWORK_NAME} || exit

case ${STAGE} in
    1)
        echo "Deploying $NETWORK_NAME network with tags: $ANSIBLE_TAGS ... stage (1)"

        if [[ $FORCED_DEPLOYMENT != 1 ]]; then
            if git symbolic-ref --quiet HEAD 2>/dev/null; then
                BRANCH=$(git symbolic-ref --short HEAD)
                if [[ $BRANCH == "devnet-"* ]]; then
                    if [[ $BRANCH != $NETWORK_NAME ]]; then
                        echo "Wrong Devnet - Check you're in the correct branch. Use -f to force if you're sure"
                        exit 1
                    fi
                fi
            else
                echo "Unable to make sure you're not deploying onto a bad network because the head is detached! Please use -f"
                exit 1
            fi
        fi

        # Setup infrastructure using Terraform
        if [ -z ${ONLY_PROVISIONING} ]; then
            terraform_run_command "apply"
        else
            echo "Skipping Terraform infrastructure deployment"
        fi

        # Install software and configure dash network using Ansible
        if [ -z ${ONLY_INFRASTRUCTURE} ]; then
            ansible_run_playbook "$ansible_playbook" --tags "$ANSIBLE_TAGS" $EXTRA_VARS
        else
            echo "Skipping Ansible provisioning"
        fi
    ;;
    2)
        ansible_run_playbook "stage2.yml" --tags "$ANSIBLE_TAGS" $EXTRA_VARS
    ;;
esac
