#!/usr/bin/env bash

set -ea

. ./lib/cli/utils.sh

ansible_playbook="deploy.yml"

# Parse command line arguments
NETWORK_NAME=""
ANSIBLE_TAGS=""

while [[ $# -gt 0 ]]; do
  case $1 in
    -p|--preset)
      NETWORK_NAME="$2"
      shift 2
      ;;
    --tags)
      ANSIBLE_TAGS="$2"
      shift 2
      ;;
    *)
      echo "Error: Unknown argument $1"
      exit 1
      ;;
  esac
done

if [ -z "$NETWORK_NAME" ] || [ -z "$ANSIBLE_TAGS" ]; then
  echo "Usage: github-deploy -p <network_name> --tags <ansible_tags>"
  exit 1
fi

. ./lib/cli/init.sh
. ./lib/cli/terraform.sh
. ./lib/cli/ansible.sh

echo "Deploying $NETWORK_NAME network with tags: $ANSIBLE_TAGS"

# Set required environment variables
export NETWORK="$NETWORK_NAME"
export NETWORK_PATH="networks/$NETWORK_NAME.yml"

# Skip Terraform for platform updates
echo "Skipping Terraform infrastructure deployment"

# Debug inventory
echo "Checking inventory file: networks/$NETWORK_NAME.inventory"
cat "networks/$NETWORK_NAME.inventory"

# List HP masternodes
echo "\nListing HP masternodes:"
ansible hp_masternodes -i "networks/$NETWORK_NAME.inventory" --list-hosts

# Test SSH connection to HP masternodes
echo "\nTesting SSH connection to HP masternodes..."
ansible hp_masternodes -i "networks/$NETWORK_NAME.inventory" -m ping -vvv || {
    echo "Failed to connect to HP masternodes"
    exit 1
}

# Run Ansible playbook with specified tags
if [[ "$ANSIBLE_TAGS" == *"platform_update"* ]]; then
    echo "Updating platform images..."
    # Run update and ignore 'Default config is not set' error
    ansible hp_masternodes -i "networks/$NETWORK_NAME.inventory" -b -m shell -a "sudo -u dashmate dashmate update || if [[ \$? -eq 1 && \$(echo \$LASTLOG) == *'Default config is not set'* ]]; then exit 0; else exit \$?; fi"
fi

# Run Ansible playbook with specified tags
echo "Running Ansible playbook with inventory: networks/$NETWORK_NAME.inventory"
ansible_run_playbook "$ansible_playbook" --tags "$ANSIBLE_TAGS" -i "networks/$NETWORK_NAME.inventory" -vv
